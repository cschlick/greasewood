[Unit]
Description=greasewood mac-node LAN seal (close non-mesh interfaces)
# Load before the mesh comes up, so a bridged NIC is never briefly open.
Before=greasewood@.service
After=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/gw-mac-lan.nft
ExecStop=-/usr/sbin/nft destroy table inet gwlan

[Install]
WantedBy=multi-user.target
