#!/usr/sbin/nft -f
# greasewood mac-gateway: NAT the host Mac's traffic into the overlay as this
# node. Masquerade = to the fleet, the Mac IS this node (grants apply as-is,
# enforced at each receiving peer). MSS clamp covers the 1500->1420 MTU step.
# "gw-*" matches whatever mesh this node joins — the file needs no editing.
destroy table ip6 gwmac
table ip6 gwmac {
    chain post {
        type nat hook postrouting priority srcnat; policy accept;
        iifname "lima0" oifname "gw-*" masquerade
    }
    chain clamp {
        type filter hook forward priority mangle; policy accept;
        # Clamp ONLY SYNs entering the mesh. `set rt mtu` is unconditional —
        # applied to both directions it also rewrote the PEER's SYN-ACK toward
        # the Mac, using the route MTU to the Mac (1500), which RAISED the
        # peer's honest 1360 to 1440. The Mac then sent 1500-byte packets into
        # the 1420 tunnel and TCP collapsed into PMTU-blackhole stalls — an
        # order-of-magnitude throughput loss on every Mac→peer bulk transfer,
        # with nothing visibly wrong. Scoped to oifname, each side is exactly
        # right: the Mac's SYN is clamped to the tunnel (protecting peer→Mac
        # data), and the peer's SYN-ACK — already sized to its own tunnel
        # interface — passes untouched (protecting Mac→peer data). This
        # matters doubly here because Apple's vmnet silently drops IPv6
        # FRAGMENTS between guest and host, so any packet that overshoots the
        # tunnel MTU has no fragmentation fallback: TCP must never need one.
        oifname "gw-*" tcp flags syn tcp option maxseg size set rt mtu
    }
}
