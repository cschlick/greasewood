#!/sbin/openrc-run
# gw-mac-gateway (OpenRC variant of gw-mac-gateway.service) — load the NAT66 +
# MSS-clamp ruleset that turns this node VM into the Mac's overlay gateway.
# Installed to /etc/init.d/gw-mac-gateway by gw-mac when it creates an Alpine
# VM; pairs with /etc/gw-mac-gateway.nft and the sysctl.d forwarding config.
description="greasewood mac-gateway: NAT66 masquerade + MSS clamp"

depend() {
    need net
    after firewall
}

start() {
    # forwarding=1 (from sysctl.d) makes the kernel ignore RAs, but the vzNAT
    # link's address and default route come from RA. accept_ra=2 keeps them.
    # It lives here, not in sysctl.d: systemd-sysctl/OpenRC's sysctl runs before
    # the interface exists, so the per-interface write silently no-ops. `need
    # net` above means the link is up by the time we get here.
    for f in /proc/sys/net/ipv6/conf/lima*/accept_ra; do
        [ -e "$f" ] && echo 2 > "$f"
    done

    # The VM's side of the gw-mac transfer net (see gw-mac-net.sh).
    ip -6 addr replace fd6d:6163::2/64 dev lima0

    ebegin "Loading gw-mac gateway nftables ruleset"
    /usr/sbin/nft -f /etc/gw-mac-gateway.nft
    eend $?
}

stop() {
    ebegin "Removing gw-mac gateway nftables ruleset"
    /usr/sbin/nft delete table ip6 gwmac 2>/dev/null
    eend 0
}
